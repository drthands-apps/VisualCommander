<Window x:Class="VisualCommander.ConfirmarEjecucionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmación de ejecución — Comando peligroso"
        Width="720" Height="560"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#FFF5F5F5"
        FontFamily="Segoe UI" FontSize="12"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SeccionTitulo" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#FF666666"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>

        <Style x:Key="CajaInfo" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFD0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Cabecera -->
        <Border DockPanel.Dock="Top"
                Background="#FFC0392B"
                Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠"
                           FontSize="24"
                           Foreground="White"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CONFIRMACIÓN DE EJECUCIÓN"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="El comando que vas a ejecutar puede ser destructivo."
                               FontSize="11"
                               Foreground="#FFFFE0E0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Botonera inferior -->
        <Border DockPanel.Dock="Bottom"
                Background="#FFEDEDED"
                BorderBrush="#FFD0D0D0"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <CheckBox x:Name="ChkNoPreguntar"
                          Content="No volver a preguntar para esta línea en esta sesión"
                          VerticalAlignment="Center"
                          FontSize="11"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="❌ Cancelar"
                            Padding="16,6"
                            Margin="0,0,8,0"
                            IsCancel="True"
                            Click="Cancelar_Click"/>
                    <Button Content="✅ Ejecutar de todas formas"
                            Padding="16,6"
                            Background="#FFC0392B"
                            Foreground="White"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Click="Ejecutar_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido scrollable -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,0,16,16">
            <StackPanel>

                <!-- Directorio de trabajo (destacado) -->
                <TextBlock Text="SE EJECUTARÁ EN:" Style="{StaticResource SeccionTitulo}"/>
                <Border x:Name="CajaDirectorio"
                        Style="{StaticResource CajaInfo}"
                        Background="#FFFFF8E1"
                        BorderBrush="#FFD4A017">
                    <TextBlock x:Name="TxtDirectorio"
                               FontFamily="Consolas"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#FF8B4513"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Comando completo -->
                <TextBlock Text="COMANDO:" Style="{StaticResource SeccionTitulo}"/>
                <Border Style="{StaticResource CajaInfo}">
                    <TextBlock x:Name="TxtComando"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="#FF222222"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Resumen de la simulación -->
                <TextBlock Text="EFECTOS:" Style="{StaticResource SeccionTitulo}"/>
                <Border Style="{StaticResource CajaInfo}"
                        Background="#FFFFF4F4"
                        BorderBrush="#FFE8A5A5">
                    <TextBlock x:Name="TxtResumen"
                               FontSize="12"
                               Foreground="#FF222222"
                               TextWrapping="Wrap"
                               LineHeight="18"/>
                </Border>

                <!-- Lista de elementos afectados -->
                <TextBlock x:Name="TituloAfectados"
                           Text="ELEMENTOS AFECTADOS:"
                           Style="{StaticResource SeccionTitulo}"/>
                <Border Style="{StaticResource CajaInfo}"
                        Height="180">
                    <ListBox x:Name="ListaAfectados"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>